# Dependencies
node_modules/

# Build output
dist/
.angular/

# Local Docker data volumes - bind mounts, never committed
local-data/

# Runtime config - never committed; use config/config.example.json as template
config/config.json
config/secrets.json
config/schema-library.json
config/schema-catalogs.json
docker-compose.override.yml

# Test instance runtime state - generated by testing/sync/setup.js; contain token hashes
testing/sync/configs/*/config.json
testing/sync/configs/*/config.json.bak
testing/sync/configs/*/secrets.json
testing/sync/configs/*/token.txt
testing/sync/configs/*/schema-library.json
testing/sync/configs/*/schema-catalogs.json
testing/sync/configs/*/backup.json

# Transient test scaffolding (local npm installs used only during dev)
testing/package.json
testing/package-lock.json

# Env files
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local-only docs
docs/docker-build-protocol.md

# Local-only working notes — never commit. The entire todo/ folder is local:
# planning trackers plus converted open-issues.
# (todo/SECURITY-TODO.md in particular describes unpatched findings — do not
# publish it before the fixes ship.)
todo/

# Correspondence with people outside the repo — never commit. Both directions of
# every conversation with a customer or canary operator, including their
# deployment details, their findings before the fixes ship, and quoted internals
# of their own systems. Theirs to share, not ours.
communication/

# Local-only automation scaffolding — n8n auditor workflow drafts + prompts.
# Not part of the shipped product; kept out of the repo by design.
n8n/

# Debug artifacts
_diag_body*.json

# Logs
*.log
npm-debug.log*

# Build / test output
*.txt
# ...but never ignore dependency manifests (e.g. Python sidecars' requirements.txt) — they're source.
!**/requirements.txt

# TypeScript build info
*.tsbuildinfo
server/dist

# Local one-command preview (not for commit)
preview.sh
preview.ps1
config/_preview_mint.mjs

# Ground-truth / bench data drawn from real deployment records. NEVER committed - this repo is public.
# Preferred location is OUTSIDE the worktree entirely (see YTHRIL_BENCH_DATA); these patterns are a
# second line of defence for anyone who puts a copy here anyway.
bench-data/
*.private.md
*.production.json

# Agent-session secrets. .claude/settings.local.json carries the `env` block supplying the
# bearer token that .mcp.json sends to a live Ythril instance. THIS REPO IS PUBLIC, so an
# unignored credential here would not be a private mistake — it would be a disclosure.
#
# Added 2026-08-05. Before this, nothing in a COMMITTED file ignored the agent config at all:
# .mcp.json was covered only by .git/info/exclude, which lives inside .git, is never committed,
# and so protects exactly one working copy and no clone. An ignore rule that does not travel
# with the repository is not protection.
.claude/settings.local.json
**/.claude/settings.local.json
